# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API.
# These two switch on accounts (sign up, log in, progress saved per account).
# Also run supabase/schema.sql once in the Supabase SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Needed for the News page explanations. Get one at console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
